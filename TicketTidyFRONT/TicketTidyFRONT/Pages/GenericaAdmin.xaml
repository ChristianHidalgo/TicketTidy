<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TicketTidyFRONT.Pages.GenericaAdmin"
             Title="Panel Administrador"
             BackgroundColor="{StaticResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25">
            <Label x:Name="lblSaludo"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}"
                   Margin="0,10,0,10" />

            <Frame CornerRadius="10"
                   Padding="15"
                   HasShadow="True"
                   BackgroundColor="{StaticResource White}">
                <Image Source="administrador_fondo_generica"
                       HeightRequest="250"
                       HorizontalOptions="Center"
                       Aspect="AspectFit" />
            </Frame>
            <Label Text="¿Qué necesitas hoy?"
                   FontSize="22"
                   FontAttributes="Italic"
                   TextColor="{StaticResource SecondaryTextColor}"
                   HorizontalOptions="Center"
                   Margin="0,20,0,20" />
            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*">
                <StackLayout Grid.Row="0" Grid.ColumnSpan="2">
                    <Grid ColumnDefinitions="Auto,*">
                        <Frame CornerRadius="8"
                               Padding="10"
                               BackgroundColor="{StaticResource PrimaryLight}"
                               WidthRequest="40"
                               HeightRequest="40"
                               HorizontalOptions="Start"
                               VerticalOptions="Center"
                               Grid.Column="0">
                            <Image Source="incidencia_icono"
                                   WidthRequest="24"
                                   HeightRequest="24" />
                        </Frame>
                        <Label Text="Listar incidencias"
                               Grid.Column="1"
                               FontSize="18"
                               TextColor="{StaticResource PrimaryTextColor}"
                               VerticalOptions="Center"
                               Margin="15,0,0,0" />
                    </Grid>
                </StackLayout>
                <Frame CornerRadius="8"
                       Padding="10"
                       BackgroundColor="{StaticResource SecondaryLight}"
                       WidthRequest="40"
                       HeightRequest="40"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       Margin="0,15,0,0"
                       Grid.Row="1"
                       Grid.Column="0">
                    <Image Source="usuarios"
                           WidthRequest="24"
                           HeightRequest="24" />
                </Frame>
                <StackLayout Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,15,0,0">
                    <Frame CornerRadius="8"
           Padding="10"
           BackgroundColor="{StaticResource SecondaryLight}"
           WidthRequest="40"
           HeightRequest="40"
           HorizontalOptions="Start"
           VerticalOptions="Center">
                        <Image Source="usuarios"
               WidthRequest="24"
               HeightRequest="24" />
                    </Frame>
                    <Label Text="Gestionar usuarios"
           FontSize="18"
           TextColor="{StaticResource PrimaryTextColor}"
           VerticalOptions="Center"
           Margin="15,0,0,0" />
                </StackLayout>
                <StackLayout Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,15,0,0">
                    <Frame CornerRadius="8"
           Padding="10"
           BackgroundColor="{StaticResource AccentLight}"
           WidthRequest="40"
           HeightRequest="40"
           HorizontalOptions="Start"
           VerticalOptions="Center">
                        <Image Source="espacios_dispositivos"
               WidthRequest="24"
               HeightRequest="24" />
                    </Frame>
                    <Label Text="Gestionar espacios y dispositivos"
           FontSize="18"
           TextColor="{StaticResource PrimaryTextColor}"
           VerticalOptions="Center"
           Margin="15,0,0,0" />
                </StackLayout>

                <StackLayout Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,15,0,0">
                    <Frame CornerRadius="8"
                           Padding="10"
                           BackgroundColor="{StaticResource Gray200}"
                           WidthRequest="40"
                           HeightRequest="40"
                           HorizontalOptions="Start"
                           VerticalOptions="Center">
                        <Image Source="usuarios"
                               WidthRequest="24"
                               HeightRequest="24" />
                    </Frame>
                    <Label Text="Listado de usuarios por tipo"
                           FontSize="18"
                           TextColor="{StaticResource PrimaryTextColor}"
                           VerticalOptions="Center"
                           Margin="15,0,0,0" />
                </StackLayout>

            </Grid>

            <Label Text="Utiliza el menú lateral para acceder a más herramientas administrativas."
                   FontSize="16"
                   TextColor="{StaticResource Gray400}"
                   FontAttributes="Italic"
                   HorizontalOptions="Center"
                   Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
