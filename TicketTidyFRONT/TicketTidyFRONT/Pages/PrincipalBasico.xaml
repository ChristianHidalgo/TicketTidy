<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:TicketTidyFRONT.Pages"
    xmlns:local="clr-namespace:TicketTidyFRONT"
    x:Class="TicketTidyFRONT.Pages.PrincipalBasico"
    x:Name="flyoutPageBasico"
    Title="Menú Usuario">

    <FlyoutPage.Flyout>
        <pages:MenuBasico />
    </FlyoutPage.Flyout>

    <FlyoutPage.Detail>
        <NavigationPage x:Name="NavigateBasico">
            <x:Arguments>
                <pages:GenericaBasico />
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>
</FlyoutPage>