<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TicketTidyFRONT.Pages.MenuAdmin"
             Title="Menú Administrador"
             BackgroundColor="{StaticResource Gray200}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <Frame Style="{StaticResource ProfileFrameStyle}">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Border Style="{StaticResource ProfileImageBorder}">
                        <Image
                x:Name="imgPerfil"
                Source="hombre.png"
                Aspect="AspectFill"
                WidthRequest="80"
                HeightRequest="80"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
                    </Border>
                    <Label x:Name="lblNombre" Style="{StaticResource ProfileNameLabel}" />
                    <Label x:Name="lblEmail" Style="{StaticResource ProfileEmailLabel}" />
                    <Label x:Name="lblId" Style="{StaticResource ProfileIdLabel}" />
                </VerticalStackLayout>
            </Frame>


            <BoxView HeightRequest="1" BackgroundColor="#DDDDDD" />
            <ListView
                x:Name="lstMenuAdmin"
                ItemsSource="{Binding listaMenuAdmin}"
                ItemTapped="lstMenuAdmin_ItemTapped"
                SelectionMode="None"
                SeparatorVisibility="None"
                HasUnevenRows="True"
                BackgroundColor="Transparent">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Frame BackgroundColor="White" CornerRadius="12" Padding="10" Margin="0,5">
                                <Grid ColumnDefinitions="Auto,*" VerticalOptions="Center">
                                    <Image Source="{Binding icono}"
                                           WidthRequest="30"
                                           HeightRequest="30"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding nombre}"
                                           Grid.Column="1"
                                           VerticalOptions="Center"
                                           FontSize="16"
                                           TextColor="Black"
                                           Margin="15,0,0,0" />
                                </Grid>
                            </Frame>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
